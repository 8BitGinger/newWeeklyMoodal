# Weather needs no key (Open-Meteo, keyless, called directly from the browser).
#
# Songs come from Firebase (structure TBD - see src/lib/firebase/songs.ts). These values are
# public client identifiers, not secrets - Firebase console -> Project settings -> General ->
# Your apps -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
